{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@tob/core": ["packages/core/src/index.ts"],
      "@tob/core/*": ["packages/core/src/*"],
      "@tob/db": ["packages/db/src/index.ts"],
      "@tob/db/*": ["packages/db/src/*"],
      "@tob/providers": ["packages/providers/src/index.ts"],
      "@tob/providers/*": ["packages/providers/src/*"],
      "@tob/runner": ["packages/runner/src/index.ts"],
      "@tob/runner/*": ["packages/runner/src/*"],
      "@tob/cli": ["packages/cli/src/index.ts"],
      "@tob/cli/*": ["packages/cli/src/*"]
    }
  }
}
